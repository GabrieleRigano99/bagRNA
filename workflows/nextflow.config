// bagRNA Nextflow DSL2 pipeline configuration
// Author: Gabriele Rigano - BCGL, University of Messina

nextflow.enable.dsl = 2

// Work dir on /mnt/newvolume (800GB+ free) instead of the default ./work under
// the root filesystem, which has run dangerously low on space (was 46GB free
// with a 504GB work/ dir before that was cleared out on 2026-09-01). Override
// per-run with -w if ever needed.
workDir = '/mnt/newvolume/bagRNA_test/bagRNA_work'

manifest {
    nextflowVersion = '!>=25.04.6,<26'
}

params {
    help                = false

    // ── Mandatory inputs ──────────────────────────────────────────────────────
    genome_fasta        = null
    prot_evidence       = null
    busco_lineage       = null
    star_manifest       = null      // path to TSV: R1.fastq.gz\tR2.fastq.gz\tcondition
    // mikado_config is no longer used — list is built dynamically from active pipeline inputs
    scoring             = "${projectDir}/assets/fungi.yaml"
    species             = null
    submission_template = null

    // ── Resources ────────────────────────────────────────────────────────────
    max_memory          = null   // override if Docker memory < physical RAM (e.g. '50GB')



    // ── Optional inputs ───────────────────────────────────────────────────────
    helixer_lineage     = null      // enables GPU Helixer run
    helixer_gff         = null      // precomputed Helixer GFF (alternative to helixer_lineage)
    transcript_evidence = null      // optional transcript FASTA aligned with GMAP → Mikado prepare
    lr_manifest         = null      // TSV of long-read FASTQ paths (one per line); enables minimap2 + StringTie --mix
    lr_type             = 'ont'     // long-read platform preset: 'ont' (splice) or 'pacbio_hifi' (splice:hq)
    pfam_db             = null      // path to pfam_a.hmm; auto-detected from --IPS6_databases_path when null
    eggnog_data_dir     = null      // path to eggNOG-mapper v7 data dir (eggnog.db, eggnog_proteins.dmnd, ...); required unless --no_eggnog
    lifted_annotation   = null
    phobius_path         = null      // path to Phobius installation (mounted at /opt/phobius)
    databases           = null      // path to databases directory
    signalp_path     = null   // path to signalp-6-package/ directory (mounted at /tools)

    // ── Performance ──────────────────────────────────────────────────────────
    threads             = 20
    ram_trinity         = '45G'
    trinity_max_cov     = 200
    max_intron_length   = 3000
    max_gene_length     = 30000
    codon_table         = 1
    strain              = 'strain'
    locus_tag           = 'bagRNA'
    genomeSAindexNbases = 11
    limitBAMsortRAM     = null        // auto-computed from task memory (90%) if not set

    // ── RNA-seq parameters ───────────────────────────────────────────────────
    orientation         = null          // override auto-detection (FR | RF | unstranded)
    strandedness        = null          // override auto-detection (secondstrand | firststrand | unstranded)

    // ── ANNEVO ───────────────────────────────────────────────────────────────
    ram_annevo          = '40gb'
    annevo_lineage      = 'fungi'
    use_gpu             = false

    // ── Run modes ────────────────────────────────────────────────────────────
    functional_anno_only = false
    protein_fasta        = null   // required with --functional_anno_only
    ncrna_fasta          = null   // optional with --functional_anno_only
    final_gff            = null   // optional with --functional_anno_only (for the functional annotation merge)
    gbk                  = null   // optional with --functional_anno_only (for antismash)

    // ── Fungal databases ──────────────────────────────────────────────────────
    dbcan_db            = null      // path to dbCAN database directory (containing CAZy.dmnd, dbCAN.hmm, etc.)
    merops_db           = null      // path to MEROPS pepunit FASTA or pre-built .dmnd
    phi_base_db         = null      // path to PHI-base FASTA or pre-built .dmnd
    go_obo              = null      // path to go-basic.obo (Gene Ontology; enables GO term propagation)
    gene2product        = null      // path to ncbi_cleaned_gene_products.txt (curated product names)
    id_map              = null      // old_id\tnew_id TSV (from rename_gff_ids.py); translates tool-output query
                                     // IDs (from before final locus-tag renaming) into the current GFF's ID
                                     // namespace for ANNOTATE_FUNCTIONAL. Without it, un-renamed tool-output IDs
                                     // (e.g. raw Mikado/TransDecoder IDs) become spurious extra "genes" in stats.

    // ── Database setup (used only with -entry SETUP) ───────────────────────
    db_dir              = null      // target directory for -entry SETUP downloads
    skip_eggnog_db      = false     // skip eggNOG-mapper databases
    skip_kofamscan_db   = false     // skip KofamScan profiles + ko_list
    skip_rfam_db        = false     // skip Rfam covariance models
    skip_dbcan_db       = false     // skip dbCAN databases
    skip_merops_db      = false     // skip MEROPS pepunit
    skip_phi_base_db    = false     // skip PHI-base
    skip_go_obo_db      = false     // skip Gene Ontology go-basic.obo
    skip_gene2product_db = false    // skip curated gene-name → product database
    skip_interproscan_db = false     // download and reformat IPS6 member databases

    // ── Isoform addition (ADD_ISOFORMS) ──────────────────────────────────────
    add_isoforms_min_tpm = 1.0    // Salmon TPM threshold for Option-2 isoforms (null = no filter)

    // ── Feature flags ────────────────────────────────────────────────────────
    jaccard_clip        = true
    no_helixer          = false
    no_trinity          = false
    no_functional_anno  = false
    no_interpro         = false
    no_eggnog           = false
    no_antismash        = false
    no_ncbi_submission  = false
    no_report           = false     // skip the final PDF + .tbl annotation report
    no_effectorp3       = false
    no_signalp          = false
    no_dbcan            = false
    no_merops           = false
    no_phi_base         = false

    // ── InterProScan 6 ────────────────────────────────────────────────────
    interproscan6_apps             = null    // null = all; or comma-separated list e.g. 'pfam,cdd,smart'
    IPS6_databases_path                 = null    // null = use InterPro API; set for offline/local mode
    interproscan6_interpro_version = 'latest' // InterPro data version; pin to match --IPS6_databases_path data (e.g. '106.0')
    interproscan6_no_matches_api        = false
    interproscan6_goterms               = true
    interproscan6_pathways              = true
    interproscan6_tmbed_signalp6_gpu_batch_size  = 200  // TMBed/SignalP6 GPU batch = this * 10; reduce if GPU OOM

    // ── Output ───────────────────────────────────────────────────────────────
    outdir              = 'results'
    tracedir            = "${params.outdir}/pipeline_info"
}

// ── Process resource labels ───────────────────────────────────────────────────
// Cap at params.max_memory if set, otherwise use physical RAM minus 4 GB headroom.
// Docker is often configured with less memory than physical RAM — override via
// --max_memory if containers fail to start due to memory limits.

process {
    // Pipeline-wide default: retry once on any transient failure (network
    // blips hitting external downloads/docker-image pulls — seen 3 times
    // across 3 different processes, Helixer/compleasm/Trinity, on a single
    // 2026-09-01 run, each time confirmed to be a one-off network hiccup, not
    // a real bug — before this was added, each one needed a manual relaunch).
    // withName: blocks below with their own errorStrategy/maxRetries (e.g.
    // TABLE2ASN's 3 retries for its internal deadlock bug) override this.
    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: 'process_low' {
        cpus   = { Math.min(4, Math.min(params.threads as int, Runtime.getRuntime().availableProcessors())) }
        memory = '8.GB'
    }
    withLabel: 'process_medium' {
        cpus   = { Math.min(8, Math.min(params.threads as int, Runtime.getRuntime().availableProcessors())) }
        memory = '16.GB'
    }
    withLabel: 'process_high' {
        cpus   = { Math.min(params.threads as int, Runtime.getRuntime().availableProcessors()) }
        memory = {
            params.max_memory
                ? nextflow.util.MemoryUnit.of(params.max_memory as String)
                : new nextflow.util.MemoryUnit(com.sun.management.OperatingSystemMXBean.class
                    .cast(java.lang.management.ManagementFactory.getOperatingSystemMXBean())
                    .getTotalPhysicalMemorySize()) - 4.GB
        }
    }
    withLabel: 'process_gpu' {
        cpus        = { Math.min(params.threads as int, Runtime.getRuntime().availableProcessors()) }
        memory      = {
            params.max_memory
                ? nextflow.util.MemoryUnit.of(params.max_memory as String)
                : new nextflow.util.MemoryUnit(com.sun.management.OperatingSystemMXBean.class
                    .cast(java.lang.management.ManagementFactory.getOperatingSystemMXBean())
                    .getTotalPhysicalMemorySize()) - 4.GB
        }
        accelerator = [request: 1, type: 'nvidia']
    }
    withLabel: 'process_long' {
        cpus   = { Math.min(params.threads as int, Runtime.getRuntime().availableProcessors()) }
        memory = {
            params.max_memory
                ? nextflow.util.MemoryUnit.of(params.max_memory as String)
                : new nextflow.util.MemoryUnit(com.sun.management.OperatingSystemMXBean.class
                    .cast(java.lang.management.ManagementFactory.getOperatingSystemMXBean())
                    .getTotalPhysicalMemorySize()) - 4.GB
        }
        time   = '72h'
    }
    // Bare name (no fully-qualified path) so this matches RUN_TMBED_GPU regardless of
    // which SCAN_SEQUENCES alias (SCAN_LOCALLY/SCAN_REMAINING/SCAN_SEQUENCES) invokes it.
    // A path-qualified selector here previously named 'SCAN_LOCALLY' but the actual run
    // used 'SCAN_SEQUENCES', so this never matched and unconstrained concurrent GPU forks
    // caused a CUDA OOM (2026-09-02, Aspergillus run).
    withName: 'RUN_TMBED_GPU' {
        maxForks = 1
    }
    withName: 'RUN_SIGNALP_GPU' {
        maxForks = 1  // same GPU, same OOM risk as RUN_TMBED_GPU above
    }
    withName: 'FUNCTIONAL_ANNOTATION:INTERPROSCAN6:LOOKUP:PREPARE_LOOKUP' {
        cache = false  // input db_releases is MapWithDefault (not Kryo-serializable); safe to re-run (exec: block, instant)
    }
    withName: 'ANTISMASH' {
        containerOptions = '--entrypoint "" -v /usr/bin/ps:/usr/bin/ps'
    }
    withName: 'RUN_DBCAN' {
        // Mount /mnt/newvolume so Docker can follow symlinks to the dbcan database directory
        containerOptions = '-v /mnt/newvolume:/mnt/newvolume'
        memory = '4.GB'   // measured peak_rss 1.7GB (run27aug, 2026-08-28); process_high default (~58GB) blocks concurrent scheduling for no reason
    }
    // ── process_high memory right-sizing ──────────────────────────────────
    // process_high's default memory (physical RAM - 4GB, ~58GB on this box) is
    // meant for the few genuinely memory-hungry steps (STAR, ANNEVO, Helixer).
    // Most process_high steps don't need anywhere near that, but Nextflow's
    // local executor reserves by DECLARED request, not actual usage — so an
    // over-declared step can block other tasks from being scheduled even when
    // real RAM is free (this is what stalled TABLE2ASN behind INFERNAL on
    // 2026-08-28: INFERNAL reserved ~58GB, used 2.76GB). These keep process_high's
    // full CPU allocation (many of these are legitimately multi-threaded) but cap
    // memory near measured peak_rss + headroom, from run27aug's execution_trace.txt.
    withName: 'FUNCTIONAL_ANNOTATION:INFERNAL' {
        memory = '8.GB'   // measured 2.76GB live
    }
    withName: 'FUNCTIONAL_ANNOTATION:DEEPKOALA' {
        memory = '4.GB'
        // Unlike this pipeline's other use_gpu-labeled tools (Helixer,
        // ANNEVO, TransDecoder2), DeepKOALA's GRU model runs fine on CPU
        // (~3.5x faster than KofamScan even without one, vs ~60-107x with)
        // — so GPU access is opportunistic (--device auto in the module
        // script) rather than a hard requirement, and only requested from
        // Docker when the user already asked for GPU use elsewhere.
        containerOptions = params.use_gpu ? '--gpus all' : ''
    }
    withName: 'STRUCTURAL_ANNOTATION:GFF_AGAT_FILTER' {
        memory = '4.GB'   // measured 1.50GB
    }
    withName: 'STRUCTURAL_ANNOTATION:GFF_CLEAN_FILTER' {
        memory = '2.GB'   // measured 0.17GB
    }
    withName: 'STRUCTURAL_ANNOTATION:MINIPROT' {
        memory = '6.GB'   // measured 2.10GB
    }
    withName: 'STRUCTURAL_ANNOTATION:MIKADO_SERIALISE' {
        memory = '8.GB'   // measured 4.00GB
    }
    withName: 'STRUCTURAL_ANNOTATION:MIKADO_PICK' {
        memory = '8.GB'   // measured 4.30GB
    }
    withName: 'STRUCTURAL_ANNOTATION:STAR_ALIGN' {
        // 20GB (measured 14.90GB on Sporothrix run27aug, 6 samples) OOM-killed
        // (exit 137) during BAM sorting on Cryptococcus depauperatus's deeper
        // sequencing (2 samples, ~9GB compressed each) 2026-09-07 — that measurement
        // doesn't scale with read depth. Raised with headroom on this 62GB box.
        memory = '40.GB'
    }
    withName: 'STRUCTURAL_ANNOTATION:ANNEVO' {
        memory = '28.GB'  // measured 20.40GB (GPU) — genuinely memory-hungry, kept well above peak
    }
    withName: 'STRUCTURAL_ANNOTATION:TABLE2ASN' {
        // table2asn has a reproducible, nondeterministic shutdown-deadlock bug
        // (confirmed via /proc/<pid>/wchan: futex_wait_queue) — it finishes its
        // real work (.gbf/.sqn/.val all fully written, no pending I/O) and then
        // hangs forever inside the binary itself, unrelated to our flags or GFF
        // (seen 3 times on 2026-08-28, twice with -Z, once without). A normal
        // run completes in ~15-17 min, so a generous time limit + retry lets
        // Nextflow detect and recover from the hang automatically instead of
        // stalling the whole pipeline for hours until someone notices.
        time         = '30.min'
        errorStrategy = 'retry'
        maxRetries    = 3
    }
    withName: 'FUNCTIONAL_ANNOTATION:EGGNOG' {
        // eggnog_data_dir (eggnog.db + eggnog_proteins.dmnd, ~46 GB) lives on
        // /mnt/newvolume; mount so Docker can follow the staged symlink.
        // DB load alone needs ~35 GB resident RAM.
        // python:3.12-slim-bookworm (the image's base) lacks procps, so `ps`
        // isn't found and nextflow's metrics wrapper hard-exits — same fix as
        // ANTISMASH / the slim-python structural modules: mount the host `ps`.
        containerOptions = '-v /mnt/newvolume:/mnt/newvolume -v /usr/bin/ps:/usr/bin/ps'
        // Capped, not scaled to --threads: the annotation-phase worker pool hits a
        // single eggnog.db file concurrently, and 24 workers reliably starved one
        // sub-batch past emapper's internal 250s timeout, killing the whole pool.
        // 8 workers ran the full 17,900-protein proteome clean.
        cpus   = 8
        memory = {
            params.max_memory
                ? nextflow.util.MemoryUnit.of(params.max_memory as String)
                : new nextflow.util.MemoryUnit(com.sun.management.OperatingSystemMXBean.class
                    .cast(java.lang.management.ManagementFactory.getOperatingSystemMXBean())
                    .getTotalPhysicalMemorySize()) - 4.GB
        }
        time   = '72h'
        // Even at the capped 8 workers, emapper's internal 250s per-sub-batch
        // timeout can still trip under heavy machine-wide contention from
        // concurrent InterProScan/other functional-annotation sub-tasks (seen
        // 2026-08-28: system load average peaked at 167 on this 32-core box).
        // Same fix pattern as TABLE2ASN above — retry rather than let a
        // transient system-load spike kill the whole multi-hour pipeline.
        errorStrategy = 'retry'
        maxRetries    = 3
    }
    withName: 'STRUCTURAL_ANNOTATION:TRANSDECODER2_PFAM_SCAN' {
        // pfam_a.hmm is on /mnt/newvolume; mount so Docker can follow the staged symlink
        containerOptions = '-v /mnt/newvolume:/mnt/newvolume'
    }
    withName: 'STRUCTURAL_ANNOTATION:(CORRECT_MISORIENTED|REMOVE_READTHROUGHS|FILTER_BY_JUNCTIONS|CLEAN_ISOFORMS_GFF|FILTER_UNSUPPORTED|ADD_ISOFORMS|FINAL_JUNCTION_FILTER|ADD_MISSING_LOCI|ADD_BUSCO_ISOFORMS|FIX_MICRO_INTRONS|REFORMAT_LOCUS_TAG_IDS_1|REFORMAT_LOCUS_TAG_IDS_2)' {
        // python:3.11-slim / python:3.12-slim lack procps; nextflow's metric
        // wrapper hard-exits if `command -v ps` fails. Mounting the host ps
        // binary satisfies that check (its runtime exec failure from missing
        // libproc2 is non-fatal). Same pattern as ANTISMASH / kegg_annotate /
        // ncbi_submission. Covers every slim-python structural module that
        // doesn't already carry the mount in its own .nf.
        containerOptions = '-v /usr/bin/ps:/usr/bin/ps'
    }

    // ── InterProScan 6 containers ─────────────────────────────────────────
    withLabel: 'ips6_container'       { container = 'docker.io/interpro/interproscan:6.0.0' }
    withLabel: 'interpro_n_container' {
        container        = 'interpro/interpro-n:latest'
        containerOptions = '--entrypoint ""'
    }
    withLabel: 'mobidblite_container' { container = 'docker.io/matblum/idrpred:1.0.3' }
    withLabel: 'signalp_container'    { container = 'docker.io/interpro/signalp:6.0i' }
    withLabel: 'deeptmhmm_container'  { container = 'docker.io/interpro/deeptmhmm:1.0' }
    withLabel: 'tmbed_container'      { container = 'docker.io/interpro/tmbed:1.0.2' }
    withLabel: 'groovy_container'     {
        container        = 'docker.io/groovy:4.0.27-jdk17'
        containerOptions = '--user root'
    }
    withLabel: 'use_gpu' { containerOptions = '--gpus all' }

    // ── InterProScan 6 resource labels ────────────────────────────────────
    withLabel: 'mem_min'        { memory = {  1.GB * task.attempt } }
    withLabel: 'mem_low'        { memory = {  2.GB * task.attempt } }
    withLabel: 'mem_medium'     { memory = {  4.GB * task.attempt } }
    withLabel: 'mem_high'       { memory = {  8.GB * task.attempt } }
    withLabel: 'mem_veryhigh'   { memory = { 12.GB * task.attempt } }
    withLabel: 'time_veryshort' { time   = 1.h  }
    withLabel: 'time_short'     { time   = 2.h  }
    withLabel: 'time_medium'    { time   = 4.h  }
    withLabel: 'time_long'      { time   = 6.h  }
}

// ── Container settings ───────────────────────────────────────────────────────
docker {
    enabled     = true
    runOptions  = '-u $(id -u):$(id -g)'
    pullTimeout = '1 hour'
}

// ── Execution profiles ───────────────────────────────────────────────────────
profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        process {
            withLabel: 'process_gpu' {
                clusterOptions = '--gres=gpu:1'
            }
        }
    }
    sge {
        process.executor = 'sge'
        process {
            withLabel: 'process_gpu' {
                clusterOptions = '-l gpu=1'
            }
        }
    }
}

// ── Tracing / reporting ──────────────────────────────────────────────────────
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.tracedir}/pipeline_dag.svg"
}
